# Copy to /volume1/docker/legal-document-builder/config/offsite-backup.env (mode 0600).
# The named rclone remote must be a crypt remote backed by Google Drive.
LEGAL_BUILDER_RCLONE_CONFIG=/volume1/docker/legal-document-builder/config/rclone.conf
LEGAL_BUILDER_OFFSITE_REMOTE=legal-builder-drive-crypt:legal-document-builder
