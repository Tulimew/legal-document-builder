APP_ENV=production
AUTH_MODE=local
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=28800
AUTH_DEVELOPMENT_BYPASS_AUTHORIZATION=false
DATABASE_URL=postgresql://legal_builder:replace-password@postgres:5432/legal_builder
DATABASE_POOL_MAX=10
HTTP_ALLOWED_ORIGINS=https://legal-builder.example.invalid

# Optional external AI providers. Configure one or more provider/model pairs.
# Never commit real API keys. Only user-selected content is sent by the AI workbench.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PUBLISHING_STORAGE_ADAPTER=filesystem
PUBLISHING_STORAGE_ROOT=/var/lib/legal-builder/publishing
PUBLISHING_WORKER_POLL_INTERVAL_MS=1000
PUBLISHING_WORKER_IDLE_BACKOFF_MS=5000
PUBLISHING_WORKER_MAX_CONSECUTIVE_ERRORS=5
